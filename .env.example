# ── Nutrivue environment variables ──────────────────────────────
# Copy this file to ".env" and fill in your real values.
# Variables starting with EXPO_PUBLIC_ are readable inside the app.
# The Supabase anon key is SAFE to expose in the app (it only allows
# what your Row-Level-Security rules permit).

# From Supabase dashboard: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── SERVER-SIDE ONLY (do NOT put in the app) ─────────────────────
# The Google Gemini API key (from Google AI Studio) lives as a Supabase
# Edge Function *secret*, set with:
#   supabase secrets set GEMINI_API_KEY=your-google-ai-studio-key
# It is intentionally NOT prefixed with EXPO_PUBLIC_ and never
# bundled into the mobile app.
